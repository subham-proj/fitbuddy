# Copy to .env at the repo root before running `docker compose up`.
#   cp .env.docker.example .env

# Host port to expose the app on (container always listens on 4000).
PORT=4000

# Public URL the app is reached at. In production the server serves the SPA,
# so this is the same origin as the app itself.
CLIENT_ORIGIN=http://localhost:4000

# --- Database --------------------------------------------------------------
# Leave blank to use the bundled `mongo` compose service.
# For MongoDB Atlas, set the full connection string here:
#   mongodb+srv://<user>:<pass>@<cluster>/fitbuddy?retryWrites=true&w=majority
MONGO_URI=

# --- Watch sync ------------------------------------------------------------
# REQUIRED in production. Use at least 24 random characters, e.g.:
#   openssl rand -hex 24
WATCH_KEY=
OWNER_USER_ID=owner

# Number of proxies in front of the app (tunnel / reverse proxy / PaaS).
TRUST_PROXY=1
