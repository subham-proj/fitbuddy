# Server configuration
NODE_ENV=development
PORT=4000

# Frontend origin allowed by CORS
CLIENT_ORIGIN=http://localhost:5173

# MongoDB connection — either set a full MONGO_URI...
# e.g. mongodb+srv://<user>:<password>@<cluster>/fitbuddy?retryWrites=true&w=majority
MONGO_URI=

# ...or provide the parts below and the URI is assembled automatically.
MONGO_USERNAME=
MONGO_PASSWORD=
MONGO_HOST=cluster0.rgujunx.mongodb.net
MONGO_DB=fitbuddy

# Watch sync — shared secret the watch phone-side service sends as `x-api-key`.
WATCH_KEY=
# Single-user deployment: all watch syncs are attributed to this user id.
OWNER_USER_ID=owner

# Number of proxies in front of the app. Set to 1 when running behind a tunnel
# (ngrok) or reverse proxy so rate limiting reads the real client IP.
TRUST_PROXY=1
