{
  "configVersion": "v2",
  "app": {
    "appId": 1132438,
    "appName": "FitBuddy Sync",
    "appType": "app",
    "version": {
      "code": 1,
      "name": "1.0.0"
    },
    "icon": "icon.png",
    "vender": "fitbuddy",
    "description": "Sync steps, calories, heart rate, sleep, stress and SpO2 to the FitBuddy backend."
  },
  "permissions": [
    "data:user.hd.step",
    "data:user.hd.calorie",
    "data:user.hd.heart_rate",
    "data:user.hd.sleep",
    "data:user.hd.stress",
    "data:user.hd.spo2"
  ],
  "runtime": {
    "apiVersion": {
      "compatible": "1.0.0",
      "target": "1.0.0",
      "minVersion": "1.0.0"
    }
  },
  "targets": {
    "common": {
      "module": {
        "page": {
          "pages": ["pages/index"]
        },
        "app-side": {
          "path": "app-side/index"
        },
        "setting": {
          "path": "setting/index"
        }
      },
      "platforms": [
        {
          "name": "gts4-mini",
          "deviceSource": 247
        },
        {
          "name": "gts4-mini-cn",
          "deviceSource": 246
        }
      ],
      "designWidth": 336
    }
  },
  "i18n": {
    "en-US": {
      "appName": "FitBuddy Sync"
    }
  },
  "defaultLanguage": "en-US"
}
